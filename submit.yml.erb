# Job submission configuration file
#
---

batch_connect:
  template: "vnc"

#
# sgd - 11/02/2018
#
script:
  native:
    - "--time"
    - "<%= bc_num_hours %>:0:0"
    - "-p"
    - "<%= partition %>"
    - "-n"
    - "<%= num_cores %>"
    - "--mem"
    - "<%= num_memory %>G"
    - "--nodes"
    - "1"
    <%- if defined?(ta_qos) && ta_qos == "interactive" -%>
    - "--qos=<%= ta_qos %>"
    <%- end -%>
